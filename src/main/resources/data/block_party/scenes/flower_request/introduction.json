{
  "trigger": "block_party:right_click",
  "filters": [
    {
      "type": "block_party:player_has_cookie",
      "filter": {
        "name": "block_party_generated.flower_request.quest_accepted",
        "not": true
      }
    }
  ],
  "actions": [
    {
      "type": "block_party:send_dialogue",
      "action": {
        "text": "Could you bring me three flowers?",
        "tooltip": true,
        "speaker": {
          "emotion": "hopeful"
        },
        "responses": [
          {
            "icon": "block_party:green_checkmark",
            "text": "Agree",
            "actions": [
              {
                "type": "block_party:player_cookie",
                "action": {
                  "operation": "set",
                  "name": "block_party_generated.flower_request.quest_accepted",
                  "value": "true"
                }
              },
              "block_party:end"
            ]
          },
          {
            "icon": "block_party:red_x",
            "text": "Decline",
            "actions": [
              "block_party:end"
            ]
          }
        ]
      }
    }
  ]
}
