{
  "trigger": "block_party:right_click",
  "filters": [
    "block_party:is_cardinal",
    {"type": "block_party:block", "filter": {"name": "minecraft:spruce_log"}},
    {"type": "block_party:player_counter", "filter": {"name": "spruce_familiarity", "operation": "equals", "value": 3}},
    {"type": "block_party:elapsed_since_marker", "filter": {"scope": "player", "name": "spruce_exchange_3", "min_game_days": 1}},
    {"type": "block_party:player_has_cookie", "filter": {"name": "spruce_befriended", "not": true}}
  ],
  "actions": [
    {"type": "block_party:send_dialogue", "action": {"text": "Good.", "tooltip": true, "responses": [
      {"icon": "block_party:next_response", "text": "...", "actions": [
        {"type": "block_party:player_cookie", "action": {"name": "spruce_befriended", "value": "true"}},
        {"type": "block_party:player_counter", "action": {"name": "spruce_familiarity", "operation": "set", "value": 4}},
        {"type": "block_party:refresh_wood_family_progression"},
        "block_party:end"
      ]}
    ]}}
  ]
}
